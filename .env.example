# ============================================================
# Axivo environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Application ---
NODE_ENV=production
# Public base URL used to build secure email action links
APP_URL=https://axivo.example.com
PORT=3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://axivo:change-me@postgres:5432/axivo?schema=public

# --- Redis (queues / cache) ---
REDIS_URL=redis://redis:6379

# --- Security secrets (generate with: openssl rand -hex 32) ---
# Session cookie signing key
SESSION_SECRET=change-me-64-hex-chars
# AES-256-GCM key for encrypting secrets at rest (SMTP passwords, temporary credentials)
ENCRYPTION_KEY=change-me-64-hex-chars
# HMAC key for signing secure email action tokens
TOKEN_SIGNING_KEY=change-me-64-hex-chars

# --- File storage (outside web root) ---
STORAGE_PATH=/var/lib/axivo/storage

# --- Initial administrator (used by prisma db seed on first run only) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Immediately-1!
