  ASSET
  ROLE_CHANGE
  GENERAL
}

enum RequestTypeKind {
  APPLICATION_ACCESS
  ASSET_REQUEST
  ASSET_HANDOVER
  ROLE_CHANGE
  CLEARANCE
  GENERAL
}

enum AppAssignmentStatus {
