// =============================================================================
// Organization (Doc 06)
// =============================================================================

model Company {
  id          String    @id @default(uuid()) @map("id") @db.Uuid
  name        String    @map("name")
  code        String    @unique @map("code")
  description String?   @map("description")
  timezone    String    @default("UTC") @map("timezone")
  currency    String    @default("USD") @map("currency")
  branding    Json?     @map("branding")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by") @db.Uuid

  departments             Department[]
  locations               Location[]
  positions               Position[]
  people                  Person[]
  approvalRoleAssignments ApprovalRoleAssignment[]
  applications            Application[]
  licenses                License[]
  assets                  Asset[]
  assetCategories         AssetCategory[]
  contracts               Contract[]
  forms                   Form[]
  workflows               Workflow[]
  requests                Request[]
  requestTypes            RequestType[]
  documents               Document[]
  documentCategories      DocumentCategory[]
  delegations             Delegation[]
  handovers               Handover[]
  clearances              Clearance[]
  settings                SystemSetting[]
  notifications           Notification[]

  @@index([isActive])
  @@map("companies")
}

model Department {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  name              String    @map("name")
  code              String?   @map("code")
  description       String?   @map("description")
  defaultLocationId String?   @map("default_location_id") @db.Uuid
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdById       String?   @map("created_by") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedById       String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")
  deletedById       String?   @map("deleted_by") @db.Uuid

  company         Company          @relation(fields: [companyId], references: [id])
  defaultLocation Location?        @relation("department_default_location", fields: [defaultLocationId], references: [id])
  people          Person[]
  departmentHeads DepartmentHead[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("departments")
}

model Location {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String    @map("name")
  code        String?   @map("code")
  description String?   @map("description")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by") @db.Uuid

  company                Company      @relation(fields: [companyId], references: [id])
  people                 Person[]
  assets                 Asset[]
  departmentsWithDefault Department[] @relation("department_default_location")

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("locations")
}

model Position {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String    @map("name")
  code        String?   @map("code")
  description String?   @map("description")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by") @db.Uuid

  company Company  @relation(fields: [companyId], references: [id])
  people  Person[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("positions")
}

/// Global approval role definitions (Department Head, HR, GM, IT Approval,
/// IT Implementation, ...). Doc 04 Ch4 - global entity.
model ApprovalRole {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @map("name")
  key         String    @unique @map("key")
  description String?   @map("description")
  isSystem    Boolean   @default(false) @map("is_system")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  assignments   ApprovalRoleAssignment[]
  workflowSteps WorkflowStep[]

  @@map("approval_roles")
}

/// Per-company assignment of an approval role to a Person (Doc 00 §5: approvers
/// do not require portal accounts; approvals happen via secure email links).
model ApprovalRoleAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  approvalRoleId String    @map("approval_role_id") @db.Uuid
  personId       String    @map("person_id") @db.Uuid
  effectiveDate  DateTime  @default(now()) @map("effective_date")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdById    String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at")
  updatedById    String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  company      Company      @relation(fields: [companyId], references: [id])
  approvalRole ApprovalRole @relation(fields: [approvalRoleId], references: [id])
  person       Person       @relation(fields: [personId], references: [id])

  @@unique([companyId, approvalRoleId, personId])
  @@index([companyId, approvalRoleId, isActive])
  @@index([personId])
  @@map("approval_role_assignments")
}

/// Department Head assignments resolve "Department Head" workflow steps for the
/// Requested For person's department (Doc 06 Ch7).
model DepartmentHead {
  id           String    @id @default(uuid()) @db.Uuid
  departmentId String    @map("department_id") @db.Uuid
  personId     String    @map("person_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdById  String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedById  String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")

  department Department @relation(fields: [departmentId], references: [id])
  person     Person     @relation(fields: [personId], references: [id])

  @@unique([departmentId, personId])
  @@index([departmentId, isActive])
  @@index([personId])
  @@map("department_heads")
}

// =============================================================================
// People & Identity (Doc 07)
// =============================================================================

model Person {
  id               String           @id @default(uuid()) @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  departmentId     String?          @map("department_id") @db.Uuid
  positionId       String?          @map("position_id") @db.Uuid
  locationId       String?          @map("location_id") @db.Uuid
  employeeId       String           @map("employee_id")
  firstName        String           @map("first_name")
  lastName         String           @map("last_name")
  email            String           @map("email")
  personalEmail    String?          @map("personal_email")
  phone            String?          @map("phone")
  extension        String?          @map("extension")
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  createdById      String?          @map("created_by") @db.Uuid
  updatedAt        DateTime         @updatedAt @map("updated_at")
  updatedById      String?          @map("updated_by") @db.Uuid
  deletedAt        DateTime?        @map("deleted_at")
  deletedById      String?          @map("deleted_by") @db.Uuid

  company    Company     @relation(fields: [companyId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  position   Position?   @relation(fields: [positionId], references: [id])
  location   Location?   @relation(fields: [locationId], references: [id])

  systemUser              SystemUser?
  orgAssignments          PersonOrgAssignment[]
  approvalRoleAssignments ApprovalRoleAssignment[]
  departmentHeadOf        DepartmentHead[]
  applicationAssignments  ApplicationAssignment[]
  licenseAssignments      LicenseAssignment[]
  assetAssignments        AssetAssignment[]
  credentialDeliveries    CredentialDelivery[]
  requestsAsRequester     Request[]                @relation("request_requester")
  requestsAsRequestedFor  Request[]                @relation("request_requested_for")
  handovers               Handover[]
  clearances              Clearance[]
  delegationsFrom         Delegation[]             @relation("delegation_from")
  delegationsTo           Delegation[]             @relation("delegation_to")
  approvalAssignments     ApprovalAssignment[]
  approvalActions         ApprovalAction[]
  contractsOwned          Contract[]               @relation("contract_owner")

  @@unique([companyId, employeeId])
  @@index([companyId, isActive])
  @@index([email])
  @@index([lastName, firstName])
  @@map("people")
}

/// Historical record of a person's organizational placement (Doc 06 Ch10 /
/// Doc 07 Ch6). The current assignment is mirrored on Person for fast lookup.
model PersonOrgAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  personId     String    @map("person_id") @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  positionId   String?   @map("position_id") @db.Uuid
  locationId   String?   @map("location_id") @db.Uuid
  effectiveAt  DateTime  @default(now()) @map("effective_at")
  endedAt      DateTime? @map("ended_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdById  String?   @map("created_by") @db.Uuid

  person Person @relation(fields: [personId], references: [id])

  @@index([personId, effectiveAt])
  @@map("person_org_assignments")
}

model SystemRole {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @map("name")
  key         String   @unique @map("key")
  description String?  @map("description")
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       SystemUser[]

  @@map("system_roles")
}

/// RBAC: permissions belong to roles only (Doc 00 §7 - no per-user overrides).
model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  systemRoleId String   @map("system_role_id") @db.Uuid
  permission   String   @map("permission")
  createdAt    DateTime @default(now()) @map("created_at")

  systemRole SystemRole @relation(fields: [systemRoleId], references: [id])

  @@unique([systemRoleId, permission])
  @@map("role_permissions")
}

model SystemUser {
  id                String    @id @default(uuid()) @db.Uuid
  personId          String    @unique @map("person_id") @db.Uuid
  systemRoleId      String    @map("system_role_id") @db.Uuid
  username          String    @unique @map("username")
  passwordHash      String    @map("password_hash")
  isEnabled         Boolean   @default(true) @map("is_enabled")
  lastLoginAt       DateTime? @map("last_login_at")
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdById       String?   @map("created_by") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedById       String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")

  person     Person     @relation(fields: [personId], references: [id])
  systemRole SystemRole @relation(fields: [systemRoleId], references: [id])
  sessions   Session[]

  inAppNotifications InAppNotification[]

  @@index([systemRoleId])
  @@map("system_users")
}

/// Server-managed sessions (Doc 05 Ch5). Cookie stores only an opaque token;
/// the SHA-256 hash of the token is persisted here.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  systemUserId      String    @map("system_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  lastActivityAt    DateTime  @default(now()) @map("last_activity_at")
  idleExpiresAt     DateTime  @map("idle_expires_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")
  revokedAt         DateTime? @map("revoked_at")

  systemUser SystemUser @relation(fields: [systemUserId], references: [id])

  @@index([systemUserId, revokedAt])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

/// Temporary login throttling per Doc 05 Ch7 (no permanent lockout).
model LoginThrottle {
  id           String    @id @default(uuid()) @db.Uuid
  identifier   String    @unique @map("identifier")
  failureCount Int       @default(0) @map("failure_count")
  windowStart  DateTime  @default(now()) @map("window_start")
  blockedUntil DateTime? @map("blocked_until")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([blockedUntil])
  @@map("login_throttle")
}

// =============================================================================
// Applications (Doc 08)
// =============================================================================

model Application {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String    @map("name")
  description String?   @map("description")
  category    String?   @map("category")
  loginUrl    String?   @map("login_url")
  icon        String?   @map("icon")
  /// Whether the same person may hold multiple simultaneous assignments
  allowMultipleAssignments Boolean @default(false) @map("allow_multiple_assignments")
  /// Whether implementing this application consumes a license
  requiresLicense Boolean  @default(false) @map("requires_license")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  createdById     String?  @map("created_by") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedById     String?  @map("updated_by") @db.Uuid
  deletedAt       DateTime? @map("deleted_at")
  deletedById     String?   @map("deleted_by") @db.Uuid

  company          Company                      @relation(fields: [companyId], references: [id])
  roles            ApplicationRole[]
  credentialFields ApplicationCredentialField[]
  assignments      ApplicationAssignment[]
  licenses         License[]
  requestItems     RequestItem[]
  credentialDeliveries CredentialDelivery[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("applications")
}

model ApplicationRole {
  id            String    @id @default(uuid()) @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  name          String    @map("name")
  description   String?   @map("description")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  createdById   String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at")
  updatedById   String?   @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")

  application  Application             @relation(fields: [applicationId], references: [id])
  assignments  ApplicationAssignment[]
  requestItems RequestItem[]

  @@unique([applicationId, name])
  @@index([applicationId, isActive])
  @@map("application_roles")
}

model ApplicationCredentialField {
  id            String              @id @default(uuid()) @db.Uuid
  applicationId String              @map("application_id") @db.Uuid
  fieldName     String              @map("field_name")
  fieldType     CredentialFieldType @map("field_type")
  isRequired    Boolean             @default(false) @map("is_required")
  displayOrder  Int                 @default(0) @map("display_order")
  helpText      String?             @map("help_text")
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  deletedAt     DateTime?           @map("deleted_at")

  application Application @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, fieldName])
  @@index([applicationId, isActive])
  @@map("application_credential_fields")
}

model ApplicationAssignment {
  id                String              @id @default(uuid()) @db.Uuid
  personId          String              @map("person_id") @db.Uuid
  applicationId     String              @map("application_id") @db.Uuid
  applicationRoleId String?             @map("application_role_id") @db.Uuid
  username          String?             @map("username")
  status            AppAssignmentStatus @default(PENDING) @map("status")
  assignedAt        DateTime            @default(now()) @map("assigned_at")
  implementedById   String?             @map("implemented_by") @db.Uuid
  requestItemId     String?             @map("request_item_id") @db.Uuid
  removedAt         DateTime?           @map("removed_at")
  removalReason     String?             @map("removal_reason")
  notes             String?             @map("notes")
  createdAt         DateTime            @default(now()) @map("created_at")
  createdById       String?             @map("created_by") @db.Uuid
  updatedAt         DateTime            @updatedAt @map("updated_at")
  updatedById       String?             @map("updated_by") @db.Uuid
  deletedAt         DateTime?           @map("deleted_at")

  person          Person               @relation(fields: [personId], references: [id])
  application     Application          @relation(fields: [applicationId], references: [id])
  applicationRole ApplicationRole?     @relation(fields: [applicationRoleId], references: [id])
  requestItem     RequestItem?         @relation(fields: [requestItemId], references: [id])
  deliveries      CredentialDelivery[]

  @@index([personId, status])
  @@index([applicationId, status])
  @@index([username])
  @@map("application_assignments")
}

// =============================================================================
// Credential Delivery (Docs 05/07/08)
// =============================================================================

model CredentialDelivery {
  id                      String                   @id @default(uuid()) @db.Uuid
  personId                String                   @map("person_id") @db.Uuid
  applicationId           String                   @map("application_id") @db.Uuid
  applicationAssignmentId String?                  @map("application_assignment_id") @db.Uuid
  requestItemId           String?                  @map("request_item_id") @db.Uuid
  username                String                   @map("username")
  /// AES-256-GCM ciphertext of the temporary secret; nulled on expiry/ack window end
  secretCiphertext        String?                  @map("secret_ciphertext")
  secretExpiresAt         DateTime?                @map("secret_expires_at")
  status                  CredentialDeliveryStatus @default(PENDING) @map("status")
  sentAt                  DateTime?                @map("sent_at")
  acknowledgedAt          DateTime?                @map("acknowledged_at")
  viewedAt                DateTime?                @map("viewed_at")
  revokedAt               DateTime?                @map("revoked_at")
  revokedById             String?                  @map("revoked_by") @db.Uuid
  createdAt               DateTime                 @default(now()) @map("created_at")
  createdById             String?                  @map("created_by") @db.Uuid
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  person                Person                    @relation(fields: [personId], references: [id])
  application           Application               @relation(fields: [applicationId], references: [id])
  applicationAssignment ApplicationAssignment?    @relation(fields: [applicationAssignmentId], references: [id])
  requestItem           RequestItem?              @relation(fields: [requestItemId], references: [id])
  fields                CredentialDeliveryField[]

  @@index([personId, status])
  @@index([status, secretExpiresAt])
  @@map("credential_deliveries")
}

/// Non-secret custom field values shown in the credential delivery
/// (Doc 08 Ch4). These remain stored after the secret expires.
model CredentialDeliveryField {
  id                   String   @id @default(uuid()) @db.Uuid
  credentialDeliveryId String   @map("credential_delivery_id") @db.Uuid
  fieldName            String   @map("field_name")
  fieldValue           String   @map("field_value")
  displayOrder         Int      @default(0) @map("display_order")
  createdAt            DateTime @default(now()) @map("created_at")

  credentialDelivery CredentialDelivery @relation(fields: [credentialDeliveryId], references: [id])

  @@index([credentialDeliveryId])
  @@map("credential_delivery_fields")
}

// =============================================================================
// Licenses (Doc 10)
// =============================================================================

model License {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  /// Optional: standalone licenses (VPN, Adobe, ...) need no application link.
  applicationId String?       @map("application_id") @db.Uuid
  name          String        @map("name")
  licenseType   LicenseType   @map("license_type")
  vendor        String?       @map("vendor")
  licenseKey    String?       @map("license_key")
  status        LicenseStatus @default(ACTIVE) @map("status")
  contractId    String?       @map("contract_id") @db.Uuid
  notes         String?       @map("notes")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  createdById   String?       @map("created_by") @db.Uuid
  updatedAt     DateTime      @updatedAt @map("updated_at")
  updatedById   String?       @map("updated_by") @db.Uuid
  deletedAt     DateTime?     @map("deleted_at")
  deletedById   String?       @map("deleted_by") @db.Uuid

  company     Company             @relation(fields: [companyId], references: [id])
  application Application?        @relation(fields: [applicationId], references: [id])
  contract    Contract?           @relation(fields: [contractId], references: [id])
  purchases   LicensePurchase[]
  assignments LicenseAssignment[]

  @@unique([companyId, name])
  @@index([companyId, status])
  @@index([applicationId])
  @@map("licenses")
}

model LicensePurchase {
  id                String              @id @default(uuid()) @db.Uuid
  licenseId         String              @map("license_id") @db.Uuid
  purchaseType      LicensePurchaseType @map("purchase_type")
  quantity          Int                 @map("quantity")
  purchaseDate      DateTime            @map("purchase_date")
  startDate         DateTime?           @map("start_date")
  expiryDate        DateTime?           @map("expiry_date")
  price             Decimal?            @map("price") @db.Decimal(14, 2)
  currency          String?             @map("currency")
  supplier          String?             @map("supplier")
  purchaseReference String?             @map("purchase_reference")
  notes             String?             @map("notes")
  createdAt         DateTime            @default(now()) @map("created_at")
  createdById       String?             @map("created_by") @db.Uuid
  updatedAt         DateTime            @updatedAt @map("updated_at")
  updatedById       String?             @map("updated_by") @db.Uuid
  deletedAt         DateTime?           @map("deleted_at")

  license License @relation(fields: [licenseId], references: [id])

  @@index([licenseId])
  @@index([expiryDate])
  @@map("license_purchases")
}

model LicenseAssignment {
  id            String                  @id @default(uuid()) @db.Uuid
  licenseId     String                  @map("license_id") @db.Uuid
  personId      String                  @map("person_id") @db.Uuid
  requestItemId String?                 @map("request_item_id") @db.Uuid
  status        LicenseAssignmentStatus @default(ACTIVE) @map("status")
  assignedAt    DateTime                @default(now()) @map("assigned_at")
  assignedById  String?                 @map("assigned_by") @db.Uuid
  removedAt     DateTime?               @map("removed_at")
  removedById   String?                 @map("removed_by") @db.Uuid
  notes         String?                 @map("notes")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  deletedAt     DateTime?               @map("deleted_at")

  license     License      @relation(fields: [licenseId], references: [id])
  person      Person       @relation(fields: [personId], references: [id])
  requestItem RequestItem? @relation(fields: [requestItemId], references: [id])

  @@index([licenseId, status])
  @@index([personId, status])
  @@map("license_assignments")
}

// =============================================================================
// Assets (Doc 11)
// =============================================================================

model AssetCategory {
  id                       String    @id @default(uuid()) @db.Uuid
  companyId                String    @map("company_id") @db.Uuid
  name                     String    @map("name")
  description              String?   @map("description")
  requireHandoverAcceptance Boolean  @default(false) @map("require_handover_acceptance")
  requireClearanceRecovery  Boolean  @default(true) @map("require_clearance_recovery")
  isActive                 Boolean   @default(true) @map("is_active")
  createdAt                DateTime  @default(now()) @map("created_at")
  createdById              String?   @map("created_by") @db.Uuid
  updatedAt                DateTime  @updatedAt @map("updated_at")
  updatedById              String?   @map("updated_by") @db.Uuid
  deletedAt                DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id])
  assets  Asset[]
  requestItems RequestItem[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("asset_categories")
}

model Asset {
  id             String      @id @default(uuid()) @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  categoryId     String      @map("category_id") @db.Uuid
  /// Human-readable asset name (required); the tag is an optional identifier.
  name           String      @default("") @map("name")
  assetTag       String?     @map("asset_tag")
  serialNumber   String?     @map("serial_number")
  manufacturer   String?     @map("manufacturer")
  model          String?     @map("model")
  status         AssetStatus @default(AVAILABLE) @map("status")
  locationId     String?     @map("location_id") @db.Uuid
  supplier       String?     @map("supplier")
  purchaseDate   DateTime?   @map("purchase_date")
  purchasePrice  Decimal?    @map("purchase_price") @db.Decimal(14, 2)
  currency       String?     @map("currency")
  warrantyExpiry DateTime?   @map("warranty_expiry")
  notes          String?     @map("notes")
  createdAt      DateTime    @default(now()) @map("created_at")
  createdById    String?     @map("created_by") @db.Uuid
  updatedAt      DateTime    @updatedAt @map("updated_at")
  updatedById    String?     @map("updated_by") @db.Uuid
  deletedAt      DateTime?   @map("deleted_at")
  deletedById    String?     @map("deleted_by") @db.Uuid

  company      Company            @relation(fields: [companyId], references: [id])
  category     AssetCategory      @relation(fields: [categoryId], references: [id])
  location     Location?          @relation(fields: [locationId], references: [id])
  assignments  AssetAssignment[]
  maintenance  AssetMaintenance[]
  disposal     AssetDisposal?

  @@unique([companyId, assetTag])
  @@index([companyId, status])
  @@index([serialNumber])
  @@index([categoryId])
  @@map("assets")
}

model AssetAssignment {
  id             String                @id @default(uuid()) @db.Uuid
  assetId        String                @map("asset_id") @db.Uuid
  personId       String                @map("person_id") @db.Uuid
  requestItemId  String?               @map("request_item_id") @db.Uuid
  status         AssetAssignmentStatus @default(ASSIGNED) @map("status")
  assignedAt     DateTime              @default(now()) @map("assigned_at")
  assignedById   String?               @map("assigned_by") @db.Uuid
  returnedAt     DateTime?             @map("returned_at")
  returnedById   String?               @map("returned_by") @db.Uuid
  acknowledgedAt DateTime?             @map("acknowledged_at")
  notes          String?               @map("notes")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  deletedAt      DateTime?             @map("deleted_at")

  asset          Asset           @relation(fields: [assetId], references: [id])
  person         Person          @relation(fields: [personId], references: [id])
  requestItem    RequestItem?    @relation(fields: [requestItemId], references: [id])
  handoverAssets HandoverAsset[]
  clearanceItems ClearanceItem[]

  @@index([assetId, status])
  @@index([personId, status])
  @@map("asset_assignments")
}

model AssetMaintenance {
  id              String            @id @default(uuid()) @db.Uuid
  assetId         String            @map("asset_id") @db.Uuid
  maintenanceType String            @map("maintenance_type")
  description     String            @map("description")
  serviceProvider String?           @map("service_provider")
  startDate       DateTime          @map("start_date")
  completionDate  DateTime?         @map("completion_date")
  cost            Decimal?          @map("cost") @db.Decimal(14, 2)
  currency        String?           @map("currency")
  status          MaintenanceStatus @default(SCHEDULED) @map("status")
  /// Asset status to restore when maintenance completes (Doc 11 Ch8)
  previousAssetStatus AssetStatus?  @map("previous_asset_status")
  notes           String?           @map("notes")
  createdAt       DateTime          @default(now()) @map("created_at")
  createdById     String?           @map("created_by") @db.Uuid
  updatedAt       DateTime          @updatedAt @map("updated_at")
  updatedById     String?           @map("updated_by") @db.Uuid
  deletedAt       DateTime?         @map("deleted_at")

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([assetId, status])
  @@map("asset_maintenance")
}

model AssetDisposal {
  id            String    @id @default(uuid()) @db.Uuid
  assetId       String    @unique @map("asset_id") @db.Uuid
  disposalDate  DateTime  @map("disposal_date")
  method        String    @map("disposal_method")
  reason        String    @map("disposal_reason")
  disposalValue Decimal?  @map("disposal_value") @db.Decimal(14, 2)
  currency      String?   @map("currency")
  approvedById  String?   @map("approved_by") @db.Uuid
  documentId    String    @map("document_id") @db.Uuid
  notes         String?   @map("notes")
  createdAt     DateTime  @default(now()) @map("created_at")
  createdById   String?   @map("created_by") @db.Uuid

  asset    Asset    @relation(fields: [assetId], references: [id])
  document Document @relation(fields: [documentId], references: [id])

  @@map("asset_disposals")
}

/// Electronic handover of one or more assets to an employee (Doc 11 Ch6).
model Handover {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  personId       String         @map("person_id") @db.Uuid
  status         HandoverStatus @default(PENDING) @map("status")
  documentId     String?        @map("document_id") @db.Uuid
  sentAt         DateTime?      @map("sent_at")
  acknowledgedAt DateTime?      @map("acknowledged_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  createdById    String?        @map("created_by") @db.Uuid
  updatedAt      DateTime       @updatedAt @map("updated_at")

  company  Company         @relation(fields: [companyId], references: [id])
  person   Person          @relation(fields: [personId], references: [id])
  document Document?       @relation(fields: [documentId], references: [id])
  assets   HandoverAsset[]

  @@index([personId, status])
  @@map("handovers")
}

model HandoverAsset {
  id                String   @id @default(uuid()) @db.Uuid
  handoverId        String   @map("handover_id") @db.Uuid
  assetAssignmentId String   @map("asset_assignment_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  handover        Handover        @relation(fields: [handoverId], references: [id])
  assetAssignment AssetAssignment @relation(fields: [assetAssignmentId], references: [id])

  @@unique([handoverId, assetAssignmentId])
  @@map("handover_assets")
}

/// Asset clearance when an employee leaves / transfers (Doc 11 Ch7).
model Clearance {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  personId       String          @map("person_id") @db.Uuid
  status         ClearanceStatus @default(IN_PROGRESS) @map("status")
  documentId     String?         @map("document_id") @db.Uuid
  completedAt    DateTime?       @map("completed_at")
  completedById  String?         @map("completed_by") @db.Uuid
  itRepresentativeId String?     @map("it_representative") @db.Uuid
  notes          String?         @map("notes")
  createdAt      DateTime        @default(now()) @map("created_at")
  createdById    String?         @map("created_by") @db.Uuid
  updatedAt      DateTime        @updatedAt @map("updated_at")

  company  Company         @relation(fields: [companyId], references: [id])
  person   Person          @relation(fields: [personId], references: [id])
  document Document?       @relation(fields: [documentId], references: [id])
  items    ClearanceItem[]

  @@index([personId, status])
  @@map("clearances")
}

model ClearanceItem {
  id                String              @id @default(uuid()) @db.Uuid
  clearanceId       String              @map("clearance_id") @db.Uuid
  assetAssignmentId String              @map("asset_assignment_id") @db.Uuid
  status            ClearanceItemStatus @default(PENDING) @map("status")
  comments          String?             @map("comments")
  verifiedAt        DateTime?           @map("verified_at")
  verifiedById      String?             @map("verified_by") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  clearance       Clearance       @relation(fields: [clearanceId], references: [id])
  assetAssignment AssetAssignment @relation(fields: [assetAssignmentId], references: [id])

  @@unique([clearanceId, assetAssignmentId])
  @@map("clearance_items")
}

// =============================================================================
// Contracts (Doc 23)
// =============================================================================

model Contract {
  id             String              @id @default(uuid()) @db.Uuid
  companyId      String              @map("company_id") @db.Uuid
  contractNumber String?             @map("contract_number")
  name           String              @map("name")
  vendor         String              @map("vendor")
  category       String              @map("category")
  status         ContractStatus      @default(DRAFT) @map("status")
  startDate      DateTime?           @map("start_date")
  endDate        DateTime?           @map("end_date")
  renewalDate    DateTime?           @map("renewal_date")
  renewalType    ContractRenewalType @default(MANUAL) @map("renewal_type")
  cost           Decimal?            @map("cost") @db.Decimal(14, 2)
  currency       String?             @map("currency")
  ownerPersonId  String?             @map("owner_person_id") @db.Uuid
  /// Reminder lead times in days before renewal/end date
  reminderDays   Json?               @map("reminder_days")
  notes          String?             @map("notes")
  createdAt      DateTime            @default(now()) @map("created_at")
  createdById    String?             @map("created_by") @db.Uuid
  updatedAt      DateTime            @updatedAt @map("updated_at")
  updatedById    String?             @map("updated_by") @db.Uuid
  deletedAt      DateTime?           @map("deleted_at")
  deletedById    String?             @map("deleted_by") @db.Uuid

  company  Company           @relation(fields: [companyId], references: [id])
  owner    Person?           @relation("contract_owner", fields: [ownerPersonId], references: [id])
  renewals ContractRenewal[]
  links    ContractLink[]
  licenses License[]

  @@unique([companyId, contractNumber])
  @@index([companyId, status])
  @@index([endDate])
  @@index([renewalDate])
  @@map("contracts")
}

model ContractRenewal {
  id           String    @id @default(uuid()) @db.Uuid
  contractId   String    @map("contract_id") @db.Uuid
  renewalDate  DateTime  @map("renewal_date")
  newStartDate DateTime? @map("new_start_date")
  newEndDate   DateTime? @map("new_end_date")
  cost         Decimal?  @map("cost") @db.Decimal(14, 2)
  currency     String?   @map("currency")
  notes        String?   @map("notes")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdById  String?   @map("created_by") @db.Uuid

  contract Contract @relation(fields: [contractId], references: [id])

  @@index([contractId])
  @@map("contract_renewals")
}

/// Optional links from a contract to vendors' applications, licenses and
/// assets (Doc 00 §9).
model ContractLink {
  id         String   @id @default(uuid()) @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  createdById String? @map("created_by") @db.Uuid

  contract Contract @relation(fields: [contractId], references: [id])

  @@unique([contractId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("contract_links")
}

// =============================================================================
// Workflows (Doc 13)
// =============================================================================

model Workflow {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String    @map("name")
  description String?   @map("description")
  isDefault   Boolean   @default(false) @map("is_default")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by") @db.Uuid

  company  Company           @relation(fields: [companyId], references: [id])
  versions WorkflowVersion[]
  forms    Form[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("workflows")
}

/// Editing an active workflow creates a new version; running instances remain
/// pinned to the version they started with (Doc 13 Ch2).
model WorkflowVersion {
  id            String    @id @default(uuid()) @db.Uuid
  workflowId    String    @map("workflow_id") @db.Uuid
  versionNumber Int       @map("version_number")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  createdById   String?   @map("created_by") @db.Uuid

  workflow  Workflow           @relation(fields: [workflowId], references: [id])
  steps     WorkflowStep[]
  instances WorkflowInstance[]

  @@unique([workflowId, versionNumber])
  @@index([workflowId, isActive])
  @@map("workflow_versions")
}

model WorkflowStep {
  id                String           @id @default(uuid()) @db.Uuid
  workflowVersionId String           @map("workflow_version_id") @db.Uuid
  stepOrder         Int              @map("step_order")
  stepName          String           @map("step_name")
  stepType          WorkflowStepType @map("step_type")
  approvalRoleId    String           @map("approval_role_id") @db.Uuid
  approvalRule      ApprovalRule     @default(ANY) @map("approval_rule")
  allowDelegation   Boolean          @default(true) @map("allow_delegation")
  commentsRequired  Boolean          @default(false) @map("comments_required")
  createdAt         DateTime         @default(now()) @map("created_at")

  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id])
  approvalRole    ApprovalRole    @relation(fields: [approvalRoleId], references: [id])

  @@unique([workflowVersionId, stepOrder])
  @@map("workflow_steps")
}

model WorkflowInstance {
  id                String                 @id @default(uuid()) @db.Uuid
  /// An item may have several instances over time (correction restarts);
  /// at most one is non-terminal at any moment.
  requestItemId     String                 @map("request_item_id") @db.Uuid
  workflowVersionId String                 @map("workflow_version_id") @db.Uuid
  status            WorkflowInstanceStatus @default(PENDING) @map("status")
  currentStepOrder  Int?                   @map("current_step_order")
  startedAt         DateTime               @default(now()) @map("started_at")
  completedAt       DateTime?              @map("completed_at")
  cancelledAt       DateTime?              @map("cancelled_at")
  cancelledById     String?                @map("cancelled_by") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  requestItem     RequestItem            @relation(fields: [requestItemId], references: [id])
  workflowVersion WorkflowVersion        @relation(fields: [workflowVersionId], references: [id])
  stepInstances   WorkflowStepInstance[]

  @@index([requestItemId])
  @@index([status])
  @@index([workflowVersionId])
  @@map("workflow_instances")
}

model WorkflowStepInstance {
  id                 String             @id @default(uuid()) @db.Uuid
  workflowInstanceId String             @map("workflow_instance_id") @db.Uuid
  stepOrder          Int                @map("step_order")
  stepName           String             @map("step_name")
  stepType           WorkflowStepType   @map("step_type")
  approvalRoleId     String             @map("approval_role_id") @db.Uuid
  approvalRule       ApprovalRule       @map("approval_rule")
  status             StepInstanceStatus @default(PENDING) @map("status")
  activatedAt        DateTime?          @map("activated_at")
  completedAt        DateTime?          @map("completed_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  workflowInstance WorkflowInstance     @relation(fields: [workflowInstanceId], references: [id])
  assignments      ApprovalAssignment[]
  actions          ApprovalAction[]

  @@unique([workflowInstanceId, stepOrder])
  @@index([status])
  @@map("workflow_step_instances")
}

/// Resolved approvers for an active step. For ALL rule every assignment must
/// approve; for ANY the first action completes the step (Doc 06 Ch6/7).
model ApprovalAssignment {
  id                     String    @id @default(uuid()) @db.Uuid
  workflowStepInstanceId String    @map("workflow_step_instance_id") @db.Uuid
  personId               String    @map("person_id") @db.Uuid
  /// When acting through delegation, the person this assignment originally targeted
  delegatedFromPersonId  String?   @map("delegated_from_person_id") @db.Uuid
  actedAt                DateTime? @map("acted_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  stepInstance WorkflowStepInstance @relation(fields: [workflowStepInstanceId], references: [id])
  person       Person               @relation(fields: [personId], references: [id])

  @@unique([workflowStepInstanceId, personId])
  @@index([personId, actedAt])
  @@map("approval_assignments")
}

model ApprovalAction {
  id                     String             @id @default(uuid()) @db.Uuid
  workflowStepInstanceId String             @map("workflow_step_instance_id") @db.Uuid
  personId               String             @map("person_id") @db.Uuid
  /// Original approver when the action was taken by a delegate
  onBehalfOfPersonId     String?            @map("on_behalf_of_person_id") @db.Uuid
  action                 ApprovalActionType @map("action")
  comments               String?            @map("comments")
  viaSecureToken         Boolean            @default(false) @map("via_secure_token")
  createdAt              DateTime           @default(now()) @map("created_at")

  stepInstance WorkflowStepInstance @relation(fields: [workflowStepInstanceId], references: [id])
  person       Person               @relation(fields: [personId], references: [id])

  @@index([workflowStepInstanceId])
  @@index([personId])
  @@map("approval_actions")
}

/// Approval delegation for a configured period (Doc 13 Ch7).
model Delegation {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  fromPersonId String    @map("from_person_id") @db.Uuid
  toPersonId   String    @map("to_person_id") @db.Uuid
  startDate    DateTime  @map("start_date")
  endDate      DateTime  @map("end_date")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdById  String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  company    Company @relation(fields: [companyId], references: [id])
  fromPerson Person  @relation("delegation_from", fields: [fromPersonId], references: [id])
  toPerson   Person  @relation("delegation_to", fields: [toPersonId], references: [id])

  @@index([fromPersonId, isActive, startDate, endDate])
  @@map("delegations")
}

// =============================================================================
// Forms & Form Builder (Doc 22)
// =============================================================================

model RequestType {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  name        String          @map("name")
  kind        RequestTypeKind @map("kind")
  description String?         @map("description")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  createdById String?         @map("created_by") @db.Uuid
  updatedAt   DateTime        @updatedAt @map("updated_at")
  updatedById String?         @map("updated_by") @db.Uuid
  deletedAt   DateTime?       @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id])
  forms   Form[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("request_types")
}

model Form {
  id                  String     @id @default(uuid()) @db.Uuid
  companyId           String     @map("company_id") @db.Uuid
  requestTypeId       String     @map("request_type_id") @db.Uuid
  workflowId          String     @map("workflow_id") @db.Uuid
  name                String     @map("name")
  description         String?    @map("description")
  /// URL-safe public identifier for the public request link
  slug                String     @unique @map("slug")
  status              FormStatus @default(DRAFT) @map("status")
  confirmationMessage String?    @map("confirmation_message")
  /// ASSET_REQUEST forms: category ids requestable through this form (null = all).
  allowedAssetCategoryIds Json?  @map("allowed_asset_category_ids")
  currentVersionId    String?    @unique @map("current_version_id") @db.Uuid
  isActive            Boolean    @default(true) @map("is_active")
  createdAt           DateTime   @default(now()) @map("created_at")
  createdById         String?    @map("created_by") @db.Uuid
  updatedAt           DateTime   @updatedAt @map("updated_at")
  updatedById         String?    @map("updated_by") @db.Uuid
  deletedAt           DateTime?  @map("deleted_at")
  deletedById         String?    @map("deleted_by") @db.Uuid

  company        Company       @relation(fields: [companyId], references: [id])
  requestType    RequestType   @relation(fields: [requestTypeId], references: [id])
  workflow       Workflow      @relation(fields: [workflowId], references: [id])
  currentVersion FormVersion?  @relation("form_current_version", fields: [currentVersionId], references: [id])
  versions       FormVersion[] @relation("form_versions")
  requests       Request[]

  @@unique([companyId, name])
  @@index([companyId, status])
  @@map("forms")
}

/// Published form versions are immutable (Doc 22). Submissions reference the
/// exact version they were made against.
model FormVersion {
  id            String    @id @default(uuid()) @db.Uuid
  formId        String    @map("form_id") @db.Uuid
  versionNumber Int       @map("version_number")
  publishedAt   DateTime? @map("published_at")
  publishedById String?   @map("published_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  form           Form        @relation("form_versions", fields: [formId], references: [id])
  currentOfForm  Form?       @relation("form_current_version")
  fields         FormField[]
  requests       Request[]

  @@unique([formId, versionNumber])
  @@map("form_versions")
}

model FormField {
  id              String        @id @default(uuid()) @db.Uuid
  formVersionId   String        @map("form_version_id") @db.Uuid
  fieldKey        String        @map("field_key")
  label           String        @map("label")
  fieldType       FormFieldType @map("field_type")
  placeholder     String?       @map("placeholder")
  helpText        String?       @map("help_text")
  isRequired      Boolean       @default(false) @map("is_required")
  defaultValue    String?       @map("default_value")
  /// Options for dropdown / multi-select / radio / checkbox fields
  options         Json?         @map("options")
  /// Validation config: min/max length, min/max value, allowed file types, max file size
  validation      Json?         @map("validation")
  displayOrder    Int           @default(0) @map("display_order")
  /// Conditional visibility rules: { logic: "AND"|"OR", conditions: [{ fieldKey, operator, value }] }
  visibilityRules Json?         @map("visibility_rules")
  createdAt       DateTime      @default(now()) @map("created_at")

  formVersion FormVersion @relation(fields: [formVersionId], references: [id])

  @@unique([formVersionId, fieldKey])
  @@index([formVersionId, displayOrder])
  @@map("form_fields")
}

// =============================================================================
// Requests (Doc 09)
// =============================================================================

model Request {
  id            String        @id @default(uuid()) @db.Uuid
  requestNumber String        @unique @map("request_number")
  companyId     String        @map("company_id") @db.Uuid
  formId        String        @map("form_id") @db.Uuid
  formVersionId String        @map("form_version_id") @db.Uuid
  status        RequestStatus @default(SUBMITTED) @map("status")

  requesterPersonId  String? @map("requester_person_id") @db.Uuid
  requesterName      String  @map("requester_name")
  requesterEmail     String  @map("requester_email")
  requesterEmployeeId String? @map("requester_employee_id")
  requesterDepartment String? @map("requester_department")
  requesterPosition  String? @map("requester_position")

  requestedForPersonId String? @map("requested_for_person_id") @db.Uuid
  requestedForName     String  @map("requested_for_name")
  requestedForEmail    String  @map("requested_for_email")
  requestedForEmployeeId String? @map("requested_for_employee_id")
  requestedForDepartment String? @map("requested_for_department")
  requestedForPosition String? @map("requested_for_position")
  requestedForDepartmentId String? @map("requested_for_department_id") @db.Uuid

  /// Immutable snapshot of the submitted custom field values
  fieldData     Json      @map("field_data")
  submittedAt   DateTime  @default(now()) @map("submitted_at")
  completedAt   DateTime? @map("completed_at")
  cancelledAt   DateTime? @map("cancelled_at")
  cancelledById String?   @map("cancelled_by") @db.Uuid
  sourceIp      String?   @map("source_ip")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company      Company     @relation(fields: [companyId], references: [id])
  form         Form        @relation(fields: [formId], references: [id])
  formVersion  FormVersion @relation(fields: [formVersionId], references: [id])
  requester    Person?     @relation("request_requester", fields: [requesterPersonId], references: [id])
  requestedFor Person?     @relation("request_requested_for", fields: [requestedForPersonId], references: [id])
  items        RequestItem[]
  corrections  RequestCorrection[]

  @@index([companyId, status])
  @@index([submittedAt])
  @@index([requesterEmail])
  @@index([requestedForEmail])
  @@map("requests")
}

model RequestItem {
  id                String            @id @default(uuid()) @db.Uuid
  requestId         String            @map("request_id") @db.Uuid
  itemType          RequestItemType   @map("item_type")
  applicationId     String?           @map("application_id") @db.Uuid
  applicationRoleId String?           @map("application_role_id") @db.Uuid
  assetCategoryId   String?           @map("asset_category_id") @db.Uuid
  description       String?           @map("description")
  /// Item-specific submitted data (editable only through the correction process)
  itemData          Json?             @map("item_data")
  status            RequestItemStatus @default(PENDING_APPROVAL) @map("status")
  implementedAt     DateTime?         @map("implemented_at")
  implementedById   String?           @map("implemented_by") @db.Uuid
  implementationNotes String?         @map("implementation_notes")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  request          Request                 @relation(fields: [requestId], references: [id])
  application      Application?            @relation(fields: [applicationId], references: [id])
  applicationRole  ApplicationRole?        @relation(fields: [applicationRoleId], references: [id])
  assetCategory    AssetCategory?          @relation(fields: [assetCategoryId], references: [id])
  workflowInstances WorkflowInstance[]
  corrections      RequestCorrection[]
  appAssignments   ApplicationAssignment[]
  licenseAssignments LicenseAssignment[]
  assetAssignments AssetAssignment[]
  credentialDeliveries CredentialDelivery[]

  @@index([requestId])
  @@index([status])
  @@map("request_items")
}

/// Correction round for a specific request item (Doc 09 Ch4/6). The original
/// data snapshot is preserved so the timeline stays intact.
model RequestCorrection {
  id             String    @id @default(uuid()) @db.Uuid
  requestId      String    @map("request_id") @db.Uuid
  requestItemId  String    @map("request_item_id") @db.Uuid
  requestedById  String?   @map("requested_by_person_id") @db.Uuid
  requestComments String   @map("request_comments")
  previousData   Json?     @map("previous_data")
  correctedData  Json?     @map("corrected_data")
  requestedAt    DateTime  @default(now()) @map("requested_at")
  submittedAt    DateTime? @map("submitted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  request     Request     @relation(fields: [requestId], references: [id])
  requestItem RequestItem @relation(fields: [requestItemId], references: [id])

  @@index([requestItemId])
  @@map("request_corrections")
}

// =============================================================================
// Secure email tokens (Doc 05 Ch8)
// =============================================================================

model SecureToken {
  id         String       @id @default(uuid()) @db.Uuid
  purpose    TokenPurpose @map("purpose")
  /// SHA-256 hash of the signed token value; raw token never stored
  tokenHash  String       @unique @map("token_hash")
  /// Email address the token was issued to
  email      String       @map("email")
  personId   String?      @map("person_id") @db.Uuid
  targetType String       @map("target_type")
  targetId   String       @map("target_id") @db.Uuid
  metadata   Json?        @map("metadata")
  expiresAt  DateTime     @map("expires_at")
  consumedAt DateTime?    @map("consumed_at")
  revokedAt  DateTime?    @map("revoked_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([expiresAt])
  @@map("secure_tokens")
}

// =============================================================================
// Documents (Doc 12)
// =============================================================================

model DocumentCategory {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  name            String    @map("name")
  description     String?   @map("description")
  retentionDays   Int?      @map("retention_days")
  allowVersioning Boolean   @default(true) @map("allow_versioning")
  isSystem        Boolean   @default(false) @map("is_system")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdById     String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  company   Company    @relation(fields: [companyId], references: [id])
  documents Document[]

  @@unique([companyId, name])
  @@map("document_categories")
}

model Document {
  id            String         @id @default(uuid()) @db.Uuid
  companyId     String         @map("company_id") @db.Uuid
  categoryId    String?        @map("category_id") @db.Uuid
  name          String         @map("name")
  kind          DocumentKind   @map("kind")
  status        DocumentStatus @default(ACTIVE) @map("status")
  currentVersion Int           @default(1) @map("current_version")
  isGenerated   Boolean        @default(false) @map("is_generated")
  notes         String?        @map("notes")
  createdAt     DateTime       @default(now()) @map("created_at")
  createdById   String?        @map("created_by") @db.Uuid
  updatedAt     DateTime       @updatedAt @map("updated_at")
  updatedById   String?        @map("updated_by") @db.Uuid

  company  Company           @relation(fields: [companyId], references: [id])
  category DocumentCategory? @relation(fields: [categoryId], references: [id])
  versions DocumentVersion[]
  links    DocumentLink[]

  handovers  Handover[]
  clearances Clearance[]
  disposals  AssetDisposal[]

  @@index([companyId, kind])
  @@index([categoryId])
  @@map("documents")
}

model DocumentVersion {
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  versionNumber Int      @map("version_number")
  filePath      String   @map("file_path")
  fileName      String   @map("file_name")
  fileSize      Int      @map("file_size")
  mimeType      String   @map("mime_type")
  checksum      String   @map("checksum")
  changeSummary String?  @map("change_summary")
  createdAt     DateTime @default(now()) @map("created_at")
  createdById   String?  @map("created_by") @db.Uuid

  document Document @relation(fields: [documentId], references: [id])

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

/// One stored document may link to many business records (Doc 12 Ch5).
model DocumentLink {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  createdById String? @map("created_by") @db.Uuid
  removedAt  DateTime? @map("removed_at")
  removedById String? @map("removed_by") @db.Uuid

  document Document @relation(fields: [documentId], references: [id])

  @@index([entityType, entityId])
  @@index([documentId])
  @@map("document_links")
}

// =============================================================================
// Notifications (Doc 14)
// =============================================================================

model NotificationTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @map("key")
  version   Int      @default(1) @map("version")
  name      String   @map("name")
  /// Notification type, e.g. APPROVAL_REQUIRED, CREDENTIAL_DELIVERY
  type      String   @map("type")
  subject   String   @map("subject")
  body      String   @map("body")
  /// Documented variables available to this template
  variables Json?    @map("variables")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  createdById String? @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  notifications Notification[]

  @@unique([key, version])
  @@index([key, isActive])
  @@map("notification_templates")
}

model Notification {
  id           String              @id @default(uuid()) @db.Uuid
  companyId    String?             @map("company_id") @db.Uuid
  templateId   String?             @map("template_id") @db.Uuid
  channel      NotificationChannel @map("channel")
  /// Business event that produced this notification
  eventType    String              @map("event_type")
  /// Deduplication key preventing duplicate notifications for one event
  dedupeKey    String?             @map("dedupe_key")
  subject      String              @map("subject")
  body         String              @map("body")
  status       NotificationStatus  @default(QUEUED) @map("status")
  attempts     Int                 @default(0) @map("attempts")
  lastError    String?             @map("last_error")
  entityType   String?             @map("entity_type")
  entityId     String?             @map("entity_id") @db.Uuid
  scheduledAt  DateTime            @default(now()) @map("scheduled_at")
  sentAt       DateTime?           @map("sent_at")
  cancelledAt  DateTime?           @map("cancelled_at")
  cancelledById String?            @map("cancelled_by") @db.Uuid
  /// Failed deliveries an administrator has cleared from the dashboard alert;
  /// the immutable delivery history itself is untouched.
  archivedAt   DateTime?           @map("archived_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  company    Company?                  @relation(fields: [companyId], references: [id])
  template   NotificationTemplate?     @relation(fields: [templateId], references: [id])
  recipients NotificationRecipient[]

  @@index([status, scheduledAt])
  @@index([entityType, entityId])
  @@index([dedupeKey])
  @@map("notifications")
}

model NotificationRecipient {
  id             String   @id @default(uuid()) @db.Uuid
  notificationId String   @map("notification_id") @db.Uuid
  personId       String?  @map("person_id") @db.Uuid
  email          String   @map("email")
  name           String?  @map("name")
  createdAt      DateTime @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id])

  @@index([notificationId])
  @@index([email])
  @@map("notification_recipients")
}

/// Portal bell notifications for signed-in users.
model InAppNotification {
  id           String    @id @default(uuid()) @db.Uuid
  systemUserId String    @map("system_user_id") @db.Uuid
  title        String    @map("title")
  body         String?   @map("body")
  link         String?   @map("link")
  readAt       DateTime? @map("read_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  systemUser SystemUser @relation(fields: [systemUserId], references: [id])

  @@index([systemUserId, readAt])
  @@map("in_app_notifications")
}

// =============================================================================
// Audit (Doc 16) - append-only; the application never updates or deletes rows.
// =============================================================================

model AuditEvent {
  id            String       @id @default(uuid()) @db.Uuid
  occurredAt    DateTime     @default(now()) @map("occurred_at")
  module        String       @map("module")
  eventType     String       @map("event_type")
  action        String       @map("action")
  outcome       AuditOutcome @default(SUCCESS) @map("outcome")
  companyId     String?      @map("company_id") @db.Uuid
  actorUserId   String?      @map("actor_user_id") @db.Uuid
  actorPersonId String?      @map("actor_person_id") @db.Uuid
  /// Display label for the actor (system user, public requester email, "system")
  actorLabel    String       @map("actor_label")
  targetType    String?      @map("target_type")
  targetId      String?      @map("target_id") @db.Uuid
  targetLabel   String?      @map("target_label")
  ipAddress     String?      @map("ip_address")
  userAgent     String?      @map("user_agent")
  correlationId String?      @map("correlation_id") @db.Uuid
  details       Json?        @map("details")

  fieldChanges AuditEventDetail[]

  @@index([occurredAt])
  @@index([module, eventType])
  @@index([companyId, occurredAt])
  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([correlationId])
  @@map("audit_events")
}

/// Per-field before/after values for change tracking (Doc 04 Ch8, Doc 16 Ch5).
model AuditEventDetail {
  id            String  @id @default(uuid()) @db.Uuid
  auditEventId  String  @map("audit_event_id") @db.Uuid
  field         String  @map("field")
  previousValue String? @map("previous_value")
  newValue      String? @map("new_value")

  auditEvent AuditEvent @relation(fields: [auditEventId], references: [id])

  @@index([auditEventId])
  @@map("audit_event_details")
}

// =============================================================================
// System Settings (Doc 17)
// =============================================================================

model SystemSetting {
  id          String       @id @default(uuid()) @db.Uuid
  key         String       @map("key")
  category    String       @map("category")
  scope       SettingScope @default(GLOBAL) @map("scope")
  companyId   String?      @map("company_id") @db.Uuid
  value       Json         @map("value")
  description String?      @map("description")
  /// Whether the value contains an encrypted secret (rendered masked)
  isSecret    Boolean      @default(false) @map("is_secret")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  updatedById String?      @map("updated_by") @db.Uuid

  company Company?               @relation(fields: [companyId], references: [id])
  history SystemSettingHistory[]

  @@unique([key, scope, companyId])
  @@index([category])
  @@map("system_settings")
}

model SystemSettingHistory {
  id            String   @id @default(uuid()) @db.Uuid
  settingId     String   @map("setting_id") @db.Uuid
  previousValue Json?    @map("previous_value")
  newValue      Json     @map("new_value")
  changedAt     DateTime @default(now()) @map("changed_at")
  changedById   String?  @map("changed_by") @db.Uuid
  reason        String?  @map("reason")

  setting SystemSetting @relation(fields: [settingId], references: [id])

  @@index([settingId, changedAt])
  @@map("system_setting_history")
}

/// Administrator-managed reference lists (Settings → Catalogs): manufacturers,
/// asset models (child of a manufacturer), suppliers, vendors and contract
/// categories used as dropdown sources across the platform.
model CatalogItem {
  id        String      @id @default(uuid()) @db.Uuid
  kind      CatalogKind @map("kind")
  name      String      @map("name")
  parentId  String?     @map("parent_id") @db.Uuid
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedAt DateTime    @updatedAt @map("updated_at")
  deletedAt DateTime?   @map("deleted_at")

  parent   CatalogItem?  @relation("catalog_parent", fields: [parentId], references: [id])
  children CatalogItem[] @relation("catalog_parent")

  @@unique([kind, name, parentId])
  @@index([kind, isActive])
  @@map("catalog_items")
}

/// Sequential business counters (e.g. request numbers) maintained atomically.
model Counter {
  key   String @id @map("key")
  value Int    @default(0) @map("value")

  @@map("counters")
}
