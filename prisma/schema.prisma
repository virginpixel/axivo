  DELIVERED
  ACKNOWLEDGED
  EXPIRED
  REVOKED
}

enum LicenseType {
  SUBSCRIPTION
  PERPETUAL
}

enum LicenseStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  RETIRED
}

enum LicensePurchaseType {
  NEW_PURCHASE
  RENEWAL
  ADDITIONAL_SEATS
}

enum LicenseAssignmentStatus {
