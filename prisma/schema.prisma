  ALL
}

enum WorkflowStepType {
  APPROVAL
  IT_APPROVAL
  IT_IMPLEMENTATION
}

enum WorkflowInstanceStatus {
  PENDING
  IN_PROGRESS
  WAITING_APPROVAL
  CORRECTION_REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
