  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
}

enum ApprovalRule {
  ANY
  ALL
}

enum WorkflowStepType {
  APPROVAL
  IT_APPROVAL
  IT_IMPLEMENTATION
}

enum WorkflowInstanceStatus {
  PENDING
  IN_PROGRESS
  WAITING_APPROVAL
  CORRECTION_REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum StepInstanceStatus {
  PENDING
  ACTIVE
  APPROVED
  REJECTED
  CORRECTION_REQUESTED
  CANCELLED
}

enum ApprovalActionType {
  APPROVED
  REJECTED
  CORRECTION_REQUESTED
}

enum RequestStatus {
  SUBMITTED
  PENDING_APPROVAL
  CORRECTION_REQUESTED
  APPROVED
  IMPLEMENTATION_PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

enum RequestItemStatus {
  PENDING_APPROVAL
  CORRECTION_REQUESTED
  APPROVED
  IMPLEMENTATION_PENDING
  IMPLEMENTED
  COMPLETED
  REJECTED
  CANCELLED
}

enum RequestItemType {
