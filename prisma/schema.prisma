// =============================================================================
// Axivo - Prisma Schema
// Implements SDS Document 04 (Database Architecture) with clarifications from
// Document 00: approval role and department head assignments resolve to People
// records (approvers do not require portal accounts) per Doc 00 §5 / Doc 13 Ch4.
//
// Conventions (Doc 04 Ch1-2):
//   - UUID primary keys generated by the application layer (default provided
//     as a safety net).
//   - snake_case table and column names via @map/@@map.
//   - UTC timestamps only.
//   - Soft delete (deleted_at) on operational records; audit rows immutable.
//   - No cascade deletes on operational business data.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

