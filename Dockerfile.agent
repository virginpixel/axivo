# Axivo host agent: the Docker CLI + Compose plugin plus a tiny Node service
# that performs the one-click update. Runs privileged (Docker socket) but is
# only reachable from the web container on the internal network and is secret
# gated.
# docker:27-cli already bundles the Compose v2 plugin; we only add Node.
FROM docker:27-cli@sha256:851f91d241214e7c6db86513b270d58776379aacc5eb9c4a87e5b47115e3065c
RUN apk add --no-cache nodejs
COPY deploy/agent.mjs /agent.mjs
EXPOSE 8099
# The base image's entrypoint wraps commands with `docker`; reset it so the
# Node agent runs directly.
ENTRYPOINT []
CMD ["node", "/agent.mjs"]
